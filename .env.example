# Required
MAX_BOT_TOKEN=your_max_bot_token
ADMIN_ID=your_max_user_id
OLLAMA_HOST=http://localhost:11434

# Optional
OLLAMA_STREAM_READ_TIMEOUT=120
OLLAMA_GENERATION_TIMEOUT=600
OLLAMA_KEEP_ALIVE=10m
# Оставьте пустыми, чтобы использовать значения самой модели
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_NUM_CTX=8192
MAX_CONTEXT_TOKENS=3000
DATABASE_URL=sqlite:///data/bot.db
DEFAULT_MODEL=llama2
TEST_MODE=false
LOG_LEVEL=INFO
