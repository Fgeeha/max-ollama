# Required
MAX_BOT_TOKEN=your_max_bot_token
ADMIN_IDS=your_max_user_id,another_admin_user_id
OLLAMA_HOST=http://localhost:11434

# Optional
# Update delivery: polling (default) or webhook
BOT_MODE=polling
# Required when BOT_MODE=webhook - public HTTPS URL registered with MAX
# WEBHOOK_URL=https://your.domain/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8081
WEBHOOK_PATH=/webhook
# Required when BOT_MODE=webhook - verifies requests actually came from MAX
# WEBHOOK_SECRET=some-shared-secret
# Bearer token for LiteLLM or other authenticated Ollama-compatible endpoints
# OLLAMA_API_KEY=your_litellm_key
# Set to "openai" if OLLAMA_HOST is a LiteLLM/OpenAI-compatible proxy without native Ollama routes
# OLLAMA_API_STYLE=ollama
OLLAMA_STREAM_READ_TIMEOUT=120
OLLAMA_GENERATION_TIMEOUT=600
OLLAMA_KEEP_ALIVE=10m
# Оставьте пустыми, чтобы использовать значения самой модели
# OLLAMA_TEMPERATURE=0.7
# OLLAMA_NUM_CTX=8192
MAX_CONTEXT_TOKENS=3000
DATABASE_URL=sqlite:///data/bot.db
DEFAULT_MODEL=llama2
TEST_MODE=false
LOG_LEVEL=INFO
